# Copy to .env (repo root) and apps/web/.env.local. Nothing here requires a paid service.
DATABASE_URL=postgres://typeicon@localhost:54329/typeicon
TEST_DATABASE_URL=postgres://typeicon@localhost:54329/typeicon_test

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3107
NEXT_PUBLIC_SITE_URL=http://localhost:3107

# Object storage: "fs" (local directory, default) or "s3" (S3/R2/MinIO)
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.data/storage
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=auto
# S3_BUCKET=typeicon
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=           # CDN origin for public release archives, if any

# Worker limits
WORKER_CONCURRENCY=1
WORKER_JOB_TIMEOUT_SECONDS=300
WORKER_MEMORY_LIMIT_MB=2048

# Build quotas (per user per hour) and upload limits
KIT_BUILDS_PER_HOUR=20
ANON_SUBSET_BUILDS_PER_HOUR=10
MAX_SUBSET_ICONS=500
MAX_CUSTOM_SVG_BYTES=65536

# Billing is intentionally unset: checkout stays hidden until product IDs exist.
# BILLING_PROVIDER=
