{
  "name": "@typeicon/figma-plugin",
  "version": "0.1.0",
  "description": "TypeIcon Figma plugin: search the TypeIcon catalog and insert editable SVG vectors.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json",
    "test": "node --test \"test/*.test.ts\" \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.139.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
